SCRIPT_PATH = Path(__file__).resolve()
TEMPLATE_DIR = SCRIPT_PATH.parent / "templates"
MANIFEST_NAME = "manifest.yaml"
GENERATED = ("nginx.conf", "docker-compose.yml")
HISTORY_JSONL = "history.jsonl"
AUDIT_REPORT_MD = "audit_report.md"
API_SERVICE = "api"
API_UID = 1000
API_GID = 1000


class CheckError(Exception):
    """Raised when a validate check fails."""

def find_repo_root(start: Path | None = None) -> Path:
    cur = (start or Path.cwd()).resolve()
    for _ in range(32):
        if (cur / MANIFEST_NAME).is_file():
            return cur
        if cur.parent == cur:
            break
        cur = cur.parent
    raise FileNotFoundError(
        f"{MANIFEST_NAME} not found in {Path.cwd().resolve()} or any parent directory"
    )


def load_manifest(root: Path) -> dict:
    path = root / MANIFEST_NAME
    with path.open(encoding="utf-8") as f:
        return yaml.safe_load(f)


def validate_manifest_structure(data: dict) -> None:
    try:
        services = data["services"]
        nginx = data["nginx"]
        net = data["network"]
        meta = data["metadata"]
    except (KeyError, TypeError) as e:
        raise CheckError(f"missing top-level section: {e}") from e

    if not isinstance(meta, dict):
        raise CheckError("metadata must be a mapping")

    mode = services.get("mode")
    checks = [
        (services.get("image"), "services.image"),
        (services.get("port"), "services.port"),
        (mode, "services.mode"),
        (nginx.get("image"), "nginx.image"),
        (nginx.get("port"), "nginx.port"),
        (nginx.get("proxy_timeout"), "nginx.proxy_timeout"),
        (net.get("name"), "network.name"),
        (net.get("driver_type"), "network.driver_type"),
        (meta.get("version"), "metadata.version"),
        (meta.get("contact"), "metadata.contact"),
        (meta.get("deployed_by"), "metadata.deployed_by"),
        (meta.get("service_name"), "metadata.service_name"),
    ]
    for val, label in checks:
        if val is None or (isinstance(val, str) and not str(val).strip()):
            raise CheckError(f"required field missing or empty: {label}")
    if str(mode).lower() not in ("stable", "canary"):
        raise CheckError("services.mode must be 'stable' or 'canary'")
    validate_policy_section(data)


def validate_policy_section(data: dict) -> None:
    try:
        pol = data["policy"]
        thr = pol["thresholds"]
        opa = pol["opa"]
    except (KeyError, TypeError) as e:
        raise CheckError(f"missing policy section: {e}") from e

    if not isinstance(thr, dict) or not isinstance(opa, dict):
        raise CheckError("policy.thresholds and policy.opa must be mappings")

    for key in (
        "min_disk_free_gb",
        "max_cpu_load",
        "max_error_rate_percent",
        "max_p99_latency_ms",
        "metrics_window_seconds",
    ):
        if thr.get(key) is None:
            raise CheckError(f"policy.thresholds.{key} is required")
    if not str(opa.get("image", "")).strip():
        raise CheckError("policy.opa.image is required")
    if opa.get("host_port") is None:
        raise CheckError("policy.opa.host_port is required")


def _compose_app_version(data: dict) -> str:
    meta = data.get("metadata") or {}
    return str(data.get("app_version") or meta.get("version") or "0.0.0")


def render_files(root: Path, data: dict) -> None:
    env = Environment(
        loader=FileSystemLoader(str(TEMPLATE_DIR)),
        autoescape=select_autoescape(enabled_extensions=()),
        trim_blocks=True,
        lstrip_blocks=True,
    )

    ctx = {
        "services": data["services"],
        "nginx": data["nginx"],
        "network": data["network"],
        "mode": data["services"]["mode"],
        "app_version": _compose_app_version(data),
        "metadata": data["metadata"],
        "policy": data["policy"],
        "compose_project": data.get("compose_project", "swiftdeploy"),
        "compose_api_service": API_SERVICE,
        "api_uid": API_UID,
        "api_gid": API_GID,
    }

    nginx_tpl = env.get_template("nginx.conf.j2")
    compose_tpl = env.get_template("docker-compose.yml.j2")

    (root / "nginx.conf").write_text(
        nginx_tpl.render(**ctx) + "\n",
        encoding="utf-8",
    )
    (root / "docker-compose.yml").write_text(
        compose_tpl.render(**ctx) + "\n",
        encoding="utf-8",
    )


def cmd_init(root: Path) -> None:
    data = load_manifest(root)
    validate_manifest_structure(data)
    render_files(root, data)
    print(f"[swiftdeploy] wrote {root / 'nginx.conf'}")
    print(f"[swiftdeploy] wrote {root / 'docker-compose.yml'}")


def _check_manifest_yaml(root: Path) -> dict:
    path = root / MANIFEST_NAME
    if not path.is_file():
        raise CheckError(f"{MANIFEST_NAME} not found at {path}")
    try:
        with path.open(encoding="utf-8") as f:
            return yaml.safe_load(f)
    except yaml.YAMLError as e:
        raise CheckError(f"invalid YAML: {e}") from e


def _check_image_exists(image: str) -> None:
    r = subprocess.run(
        ["docker", "image", "inspect", image],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        raise CheckError(
            f"docker image not found locally: {image}\n"
            f"Build it from the repo root, e.g.\n"
            f"  docker build -t {image} ."
        )


def _check_port_free(port: int) -> None:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("0.0.0.0", port))
    except OSError as e:
        raise CheckError(f"nginx port {port} is already in use on this host: {e}") from e
    finally:
        s.close()


def _check_nginx_syntax(root: Path, data: dict) -> None:
    env = Environment(
        loader=FileSystemLoader(str(TEMPLATE_DIR)),
        autoescape=select_autoescape(enabled_extensions=()),
    )
    ctx = {
        "services": data["services"],
        "nginx": data["nginx"],
        "network": data["network"],
        "mode": data["services"]["mode"],
        "app_version": _compose_app_version(data),
        "metadata": data["metadata"],
        "policy": data["policy"],
        "compose_project": data.get("compose_project", "swiftdeploy"),
        "compose_api_service": API_SERVICE,
        "api_uid": API_UID,
        "api_gid": API_GID,
    }

    text = env.get_template("nginx.conf.j2").render(**ctx)

    nginx_image = data["nginx"]["image"]
    with tempfile.NamedTemporaryFile(
        mode="w",
        suffix=".conf",
        delete=False,
        encoding="utf-8",
    ) as tmp:
        tmp.write(text + "\n")
        tmp_path = tmp.name

    try:
        host_conf = Path(tmp_path).resolve()
        mount = f"{host_conf.as_posix()}:/etc/nginx/nginx.conf:ro"
        # Nginx resolves upstream hostnames at config-load time. The real Compose network
        # is not attached here, so stub ``api`` (service name) to a dummy IP - ``nginx -t``
        # only needs DNS to succeed, not a listening upstream.
        r = subprocess.run(
            [
                "docker",
                "run",
                "--rm",
                "--add-host",
                f"{API_SERVICE}:127.0.0.1",
                "-v",
                mount,
                nginx_image,
                "nginx",
                "-t",
            ],
            capture_output=True,
            text=True,
        )
        if r.returncode != 0:
            msg = (r.stderr or r.stdout or "").strip()
            raise CheckError(f"nginx -t failed: {msg}")
    finally:
        Path(tmp_path).unlink(missing_ok=True)


def cmd_validate(root: Path) -> int:
    print("[swiftdeploy] validate - running pre-flight checks\n")

    manifest_data: dict | None = None

    def run_check(label: str, fn) -> bool:
        try:
            fn()
            print(f"[PASS] {label}")
            return True
        except CheckError as e:
            print(f"[FAIL] {label}")
            print(f"       {e}")
            return False

    def load_yaml_check():
        nonlocal manifest_data
        manifest_data = _check_manifest_yaml(root)

    if not run_check("manifest.yaml exists and is valid YAML", load_yaml_check):
        return 1
    assert manifest_data is not None

    if not run_check(
        "required manifest fields are present and non-empty",
        lambda: validate_manifest_structure(manifest_data),
    ):
        return 1

    ok_img = run_check(
        "Docker image referenced in the manifest exists locally",
        lambda: _check_image_exists(manifest_data["services"]["image"]),
    )
    ok_port = run_check(
        "host port nginx.port (from manifest) is available for binding",
        lambda: _check_port_free(int(manifest_data["nginx"]["port"])),
    )
    ok_ngx = run_check(
        "rendered nginx.conf is syntactically valid (nginx -t)",
        lambda: _check_nginx_syntax(root, manifest_data),
    )

    if not (ok_img and ok_port and ok_ngx):
        return 1

    print("\n[swiftdeploy] validate: all checks passed")
    return 0


def _compose_base(root: Path, data: dict) -> list[str]:
    proj = data.get("compose_project", "swiftdeploy")
    return [
        "docker",
        "compose",
        "-f",
        str(root / "docker-compose.yml"),
        "-p",
        proj,
    ]


@dataclass
class OpaOutcome:
    ok: bool
    decision: dict | None
    failure_kind: str | None
    failure_message: str | None


def opa_base_url(data: dict) -> str:
    port = int(data["policy"]["opa"]["host_port"])
    return f"http://127.0.0.1:{port}"


def thresholds_payload(data: dict) -> dict:
    t = data["policy"]["thresholds"]
    return {
        "min_disk_free_gb": float(t["min_disk_free_gb"]),
        "max_cpu_load": float(t["max_cpu_load"]),
        "max_error_rate_percent": float(t["max_error_rate_percent"]),
        "max_p99_latency_ms": float(t["max_p99_latency_ms"]),
        "metrics_window_seconds": float(t["metrics_window_seconds"]),
    }


def collect_host_stats() -> tuple[dict | None, str | None]:
    if psutil is None:
        return None, "psutil missing - install CLI deps: python -m pip install -r requirements-cli.txt"
    try:
        du = psutil.disk_usage(os.path.abspath(os.sep))
        free_gb = du.free / (1024**3)
        try:
            load1 = float(os.getloadavg()[0])
        except (AttributeError, OSError):
            # Windows has no loadavg; approximate busy-ness from CPU %
            load1 = (
                float(psutil.cpu_percent(interval=0.15))
                / 100.0
                * max(1, psutil.cpu_count(logical=True) or 1)
            )
        return {
            "disk_free_gb": round(free_gb, 4),
            "cpu_load_1m": round(load1, 4),
        }, None
    except OSError as e:
        return None, f"host stats error: {e}"


def http_post_json(
    url: str,
    payload: dict,
    connect_timeout: float = 2.0,
    read_timeout: float = 12.0,
) -> OpaOutcome:
    body = json.dumps({"input": payload}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(
            req,
            timeout=float(connect_timeout) + float(read_timeout),
        ) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as e:
        err_body = e.read().decode(errors="replace") if e.fp else ""
        return OpaOutcome(
            False,
            None,
            "opa_http_error",
            f"OPA HTTP {e.code}: {err_body[:800]}",
        )
    except urllib.error.URLError as e:
        reason = getattr(e, "reason", e)
        if isinstance(reason, ConnectionRefusedError):
            return OpaOutcome(
                False,
                None,
                "opa_connection_refused",
                "OPA unreachable (connection refused). Start with: docker compose up -d opa",
            )
        return OpaOutcome(False, None, "opa_url_error", f"OPA network error: {reason}")
    except TimeoutError:
        return OpaOutcome(False, None, "opa_timeout", "OPA request timed out (read).")
    except socket.timeout:
        return OpaOutcome(False, None, "opa_timeout", "OPA request timed out (socket).")
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as e:
        return OpaOutcome(False, None, "opa_bad_json", f"OPA invalid JSON: {e}")
    result = parsed.get("result")
    if result is None:
        snippet = raw[:600]
        return OpaOutcome(False, None, "opa_no_result", f"OPA missing 'result' key: {snippet}")
    return OpaOutcome(True, result, None, None)


def query_opa_decision(data: dict, path_under_data: str, input_payload: dict) -> OpaOutcome:
    """POST /v1/data/<path> e.g. swiftdeploy/infrastructure/decision"""
    url = f"{opa_base_url(data)}/v1/data/{path_under_data}"
    return http_post_json(url, input_payload)


def wait_opa_ready(data: dict, deadline_s: float = 75.0) -> OpaOutcome:
    base = opa_base_url(data)
    url = f"{base}/health?bundle=false"
    deadline = time.monotonic() + deadline_s
    last_err: str | None = None
    while time.monotonic() < deadline:
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=5.0) as resp:
                if resp.status == 200:
                    return OpaOutcome(True, {}, None, None)
        except Exception as e:
            last_err = str(e)
        time.sleep(0.6)
    return OpaOutcome(
        False,
        None,
        "opa_wait_timeout",
        f"OPA did not become healthy within {deadline_s}s. Last error: {last_err}",
    )


def run_pre_deploy_policy(data: dict) -> OpaOutcome:
    stats, err = collect_host_stats()
    if stats is None:
        return OpaOutcome(False, None, "host_stats_unavailable", err or "host stats unavailable")
    inp = {
        "phase": "pre_deploy",
        "thresholds": thresholds_payload(data),
        "host": stats,
    }
    return query_opa_decision(data, "swiftdeploy/infrastructure/decision", inp)


def metrics_url(data: dict) -> str:
    return f"http://127.0.0.1:{int(data['nginx']['port'])}/metrics"


def healthz_url(data: dict) -> str:
    return f"http://127.0.0.1:{int(data['nginx']['port'])}/healthz"


def fetch_healthz_payload(data: dict) -> tuple[dict | None, str | None]:
    url = healthz_url(data)
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=2.0) as resp:
            body = resp.read().decode()
            return json.loads(body), None
    except urllib.error.HTTPError as e:
        return None, f"healthz HTTP {e.code}"
    except urllib.error.URLError as e:
        return None, f"healthz unreachable: {getattr(e, 'reason', e)}"
    except (TimeoutError, ValueError, json.JSONDecodeError) as e:
        return None, str(e)


def fetch_metrics_text(url: str) -> tuple[str | None, str | None]:
    try:
        req = urllib.request.Request(url, headers={"Accept": "text/plain"})
        with urllib.request.urlopen(req, timeout=12.0) as resp:
            return resp.read().decode(), None
    except urllib.error.HTTPError as e:
        return None, f"metrics HTTP error {e.code}"
    except urllib.error.URLError as e:
        r = getattr(e, "reason", e)
        return None, f"metrics unreachable: {r}"
    except TimeoutError:
        return None, "metrics request timed out"


def gauge_value(metrics_text: str, name: str) -> float | None:
    for fam in text_string_to_metric_families(metrics_text):
        if fam.name != name:
            continue
        for s in fam.samples:
            return float(s.value)
    return None


def sum_counter(metrics_text: str, name: str) -> float:
    total = 0.0
    for fam in text_string_to_metric_families(metrics_text):
        if fam.name != name:
            continue
        for s in fam.samples:
            total += float(s.value)
    return total


def window_metrics_from_prometheus(text: str, data: dict) -> dict:
    thr = thresholds_payload(data)
    ws = int(thr["metrics_window_seconds"])
    wr = gauge_value(text, "swiftdeploy_window_requests_total") or 0.0
    we = gauge_value(text, "swiftdeploy_window_errors_total") or 0.0
    p99s = gauge_value(text, "swiftdeploy_window_p99_latency_seconds") or 0.0
    err_rate = (we / wr * 100.0) if wr > 0 else 0.0
    return {
        "window_seconds": ws,
        "error_rate_percent": round(err_rate, 6),
        "p99_latency_ms": round(p99s * 1000.0, 6),
        "window_requests": wr,
        "window_errors": we,
    }


def run_pre_promote_canary_policy(
    data: dict,
    metrics_text: str,
    promotion_target: str,
) -> OpaOutcome:
    if promotion_target == "stable":
        met = {
            "window_seconds": int(thresholds_payload(data)["metrics_window_seconds"]),
            "error_rate_percent": 0.0,
            "p99_latency_ms": 0.0,
        }
    else:
        met = window_metrics_from_prometheus(metrics_text, data)
    inp = {
        "phase": "pre_promote",
        "promotion_target": promotion_target,
        "thresholds": thresholds_payload(data),
        "metrics": met,
    }
    return query_opa_decision(data, "swiftdeploy/canary/decision", inp)


def opa_snapshot(out: OpaOutcome) -> dict[str, object]:
    if not out.ok:
        return {"ok": False, "error": out.failure_message or "unknown"}
    dec = out.decision or {}
    return {
        "ok": True,
        "allowed": bool(dec.get("allowed")),
        "reasons": dec.get("reasons"),
        "domain": dec.get("domain"),
    }


def print_opa_status(label: str, out: OpaOutcome) -> None:
    if not out.ok:
        print(f"  OPA [{label}]: TRANSPORT ERROR - {out.failure_message}")
        return
    dec = out.decision or {}
    if dec.get("allowed"):
        print(f"  OPA [{label}]: ALLOW")
        return
    print(f"  OPA [{label}]: DENY")
    for line in dec.get("reasons") or []:
        print(f"    - {line}")


def append_history(root: Path, record: dict) -> None:
    path = root / HISTORY_JSONL
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def cmd_deploy(root: Path, timeout_s: float = 60.0) -> int:
    cmd_init(root)
    data = load_manifest(root)
    compose_cmd = _compose_base(root, data)

    print("[swiftdeploy] starting OPA (policy engine) …")
    r = subprocess.run(compose_cmd + ["up", "-d", "opa"], cwd=root)
    if r.returncode != 0:
        print("[swiftdeploy] failed to start OPA container")
        return r.returncode

    ready = wait_opa_ready(data)
    if not ready.ok:
        print(f"[swiftdeploy] OPA not ready: {ready.failure_message}")
        return 1

    infra = run_pre_deploy_policy(data)
    if not infra.ok:
        print(f"[swiftdeploy] pre-deploy policy: transport error - {infra.failure_message}")
        return 1
    idec = infra.decision or {}
    if not idec.get("allowed", False):
        print("[swiftdeploy] POLICY VIOLATION - deploy blocked (infrastructure).")
        for line in idec.get("reasons") or []:
            print(f"  - {line}")
        return 1
    print("[swiftdeploy] pre-deploy policy: ALLOW")

    print("[swiftdeploy] docker compose up --build -d")
    r = subprocess.run(
        compose_cmd + ["up", "--build", "-d"],
        cwd=root,
    )
    if r.returncode != 0:
        print("[swiftdeploy] deploy failed: compose up returned non-zero")
        return r.returncode

    nginx_port = int(data["nginx"]["port"])
    url = f"http://127.0.0.1:{nginx_port}/healthz"
    deadline = time.monotonic() + timeout_s
    print(f"[swiftdeploy] waiting for healthy proxy at {url} (timeout {timeout_s}s)")
    while time.monotonic() < deadline:
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=2.0) as resp:
                if resp.status == 200:
                    body = resp.read().decode()
                    print("[swiftdeploy] health check OK:")
                    print(body)
                    return 0
        except (urllib.error.URLError, TimeoutError, ConnectionResetError):
            pass
        time.sleep(1.0)

    print("[swiftdeploy] deploy timed out waiting for /healthz via nginx")
    return 1


def cmd_promote(root: Path, target: str) -> int:
    target = target.lower()
    if target not in ("canary", "stable"):
        print("[swiftdeploy] promote requires: canary | stable")
        return 2

    path = root / MANIFEST_NAME
    data = load_manifest(root)
    validate_manifest_structure(data)

    if target == "canary":
        murl = metrics_url(data)
        mtext, merr = fetch_metrics_text(murl)
        if mtext is None:
            print(f"[swiftdeploy] pre-promote: cannot scrape metrics: {merr}")
            return 1
        pr = run_pre_promote_canary_policy(data, mtext, "canary")
    else:
        pr = run_pre_promote_canary_policy(data, "", "stable")

    if not pr.ok:
        print(f"[swiftdeploy] pre-promote policy: transport error - {pr.failure_message}")
        return 1
    pdec = pr.decision or {}
    if not pdec.get("allowed", False):
        print("[swiftdeploy] POLICY VIOLATION - promote blocked (canary safety policy).")
        for line in pdec.get("reasons") or []:
            print(f"  - {line}")
        return 1
    print("[swiftdeploy] pre-promote policy: ALLOW")

    current = str(data["services"]["mode"]).lower()
    if current != target:
        data["services"]["mode"] = target
        with path.open("w", encoding="utf-8") as f:
            yaml.safe_dump(
                data,
                f,
                sort_keys=False,
                default_flow_style=False,
                allow_unicode=True,
            )

    cmd_init(root)
    compose_cmd = _compose_base(root, load_manifest(root))

    print(f"[swiftdeploy] restarting service '{API_SERVICE}' with MODE={target}")
    r = subprocess.run(
        compose_cmd
        + [
            "up",
            "-d",
            "--no-deps",
            "--force-recreate",
            API_SERVICE,
        ],
        cwd=root,
    )
    if r.returncode != 0:
        return r.returncode

    nginx_port = int(load_manifest(root)["nginx"]["port"])
    url = f"http://127.0.0.1:{nginx_port}/healthz"
    deadline = time.monotonic() + 45.0
    mode_ok = False
    last_body = ""
    while time.monotonic() < deadline:
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=2.0) as resp:
                last_body = resp.read().decode()
                payload = json.loads(last_body)
                if payload.get("mode") == target:
                    mode_ok = True
                    break
        except (urllib.error.URLError, TimeoutError, ValueError, json.JSONDecodeError):
            pass
        time.sleep(0.5)

    print("[swiftdeploy] GET /healthz response:")
    print(last_body or "(empty)")
    if not mode_ok:
        print(f"[swiftdeploy] promote verification failed: expected mode={target!r} from /healthz")
        return 1

    print(f"[swiftdeploy] promote complete - active mode is {target!r}")
    return 0


def cmd_status(root: Path, interval_s: float = 3.0, iterations: int | None = None) -> int:
    try:
        data = load_manifest(root)
        validate_manifest_structure(data)
    except (FileNotFoundError, CheckError) as e:
        print(f"[swiftdeploy] status: {e}")
        return 1

    prev_total: float | None = None
    prev_mono: float | None = None
    done = 0
    print("[swiftdeploy] live status (Ctrl+C to stop)")
    try:
        while True:
            ts = time.time()
            iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))

            hz, herr = fetch_healthz_payload(data)
            mode = (hz or {}).get("mode")

            mtext, merr = fetch_metrics_text(metrics_url(data))

            rps_val: float | None = None
            wm: dict[str, float | int] = {}
            if mtext is not None:
                now_m = time.monotonic()
                total = sum_counter(mtext, "http_requests_total")
                if prev_total is not None and prev_mono is not None:
                    dt = now_m - prev_mono
                    if dt > 0:
                        rps_val = (total - prev_total) / dt
                prev_total = total
                prev_mono = now_m
                wm = window_metrics_from_prometheus(mtext, data)

            infra = run_pre_deploy_policy(data)
            canary_pre = (
                run_pre_promote_canary_policy(data, mtext, "canary")
                if mtext is not None
                else OpaOutcome(
                    False,
                    None,
                    "no_metrics",
                    "metrics unavailable for canary policy",
                )
            )

            append_history(
                root,
                {
                    "ts": ts,
                    "iso": iso,
                    "mode": mode,
                    "healthz_error": herr,
                    "metrics_error": merr,
                    "req_per_s": rps_val,
                    "window": wm,
                    "opa_infrastructure": opa_snapshot(infra),
                    "opa_canary_promote": opa_snapshot(canary_pre),
                },
            )

            rps_disp = f"{rps_val:.4f}" if rps_val is not None else "n/a"
            print(f"\n=== {iso}  mode={mode!r}  req/s~={rps_disp} ===")
            if herr:
                print(f"  healthz: ERROR - {herr}")
            if merr:
                print(f"  metrics: ERROR - {merr}")
            if wm:
                print(
                    f"  window({wm['window_seconds']}s): "
                    f"errors={wm['window_errors']:.0f}/{wm['window_requests']:.0f} "
                    f"err_rate={wm['error_rate_percent']}% "
                    f"p99={wm['p99_latency_ms']}ms"
                )
            print_opa_status("infrastructure (pre-deploy)", infra)
            print_opa_status("canary (hypothetical promote->canary)", canary_pre)

            done += 1
            if iterations is not None and done >= iterations:
                break
            time.sleep(max(0.5, interval_s))
    except KeyboardInterrupt:
        print("\n[swiftdeploy] status stopped.")
    return 0


def cmd_audit(root: Path) -> int:
    hist_path = root / HISTORY_JSONL
    if not hist_path.is_file():
        print("[swiftdeploy] audit: no history.jsonl - run `swiftdeploy status` first.")
        return 1

    records: list[dict] = []
    with hist_path.open(encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    if not records:
        print("[swiftdeploy] audit: history.jsonl empty or unreadable")
        return 1

    violations: list[dict[str, object]] = []
    errors: list[dict[str, object]] = []

    for rec in records:
        ts = rec.get("iso") if rec.get("iso") is not None else rec.get("ts")
        for label, key in (
            ("infrastructure", "opa_infrastructure"),
            ("canary_promote", "opa_canary_promote"),
        ):
            snap = rec.get(key)
            if not isinstance(snap, dict):
                continue
            if not snap.get("ok"):
                errors.append({"time": ts, "domain": label, "detail": snap.get("error")})
            elif snap.get("allowed") is False:
                violations.append({"time": ts, "domain": label, "reasons": snap.get("reasons")})

    gen_iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    lines_out = [
        "# SwiftDeploy audit report",
        "",
        f"Generated: `{gen_iso}` (UTC)",
        "",
        "## Summary",
        "",
        f"- Timeline samples: **{len(records)}**",
        f"- Policy denials (`allowed: false`): **{len(violations)}**",
        f"- OPA transport / parser errors: **{len(errors)}**",
        "",
        "## Violations",
        "",
    ]

    if violations:
        lines_out.extend(
            [
                "| Time (UTC) | Domain | Reasons |",
                "|------------|--------|---------|",
            ]
        )
        for v in violations:
            rs = v.get("reasons") or []
            rs_esc = "; ".join(str(x) for x in rs).replace("|", "\\|")
            lines_out.append(f"| {v.get('time')} | {v['domain']} | {rs_esc} |")
        lines_out.append("")
    else:
        lines_out.extend(["_No policy denials recorded._", ""])

    lines_out.extend(["## OPA / metrics plumbing errors", ""])
    if errors:
        lines_out.extend(
            [
                "| Time (UTC) | Domain | Detail |",
                "|------------|--------|--------|",
            ]
        )
        for e in errors:
            det = str(e.get("detail", "")).replace("|", "\\|")[:500]
            lines_out.append(f"| {e.get('time')} | {e['domain']} | {det} |")
        lines_out.append("")
    else:
        lines_out.extend(["_None._", ""])

    def snap_cell(snap: object) -> str:
        if not isinstance(snap, dict):
            return "-"
        if not snap.get("ok"):
            return "ERR"
        return "OK" if snap.get("allowed") else "DENY"

    lines_out.extend(["## Recent timeline (last 25 samples)", ""])
    tail = records[-25:]
    lines_out.extend(
        [
            "| Time | Mode | req/s | err% | P99 ms | infra | canary↑ |",
            "|------|------|-------|------|--------|-------|---------|",
        ]
    )
    for rec in tail:
        wm = rec.get("window")
        if not isinstance(wm, dict):
            wm = {}
        rps = rec.get("req_per_s")
        rps_s = f"{float(rps):.3f}" if isinstance(rps, (int, float)) else "-"
        errp = wm.get("error_rate_percent", "-")
        p99 = wm.get("p99_latency_ms", "-")
        opi = rec.get("opa_infrastructure")
        opc = rec.get("opa_canary_promote")
        lines_out.append(
            f"| {rec.get('iso')} | {rec.get('mode')} | {rps_s} | {errp} | {p99} | "
            f"{snap_cell(opi)} | {snap_cell(opc)} |"
        )
    lines_out.append("")

    out_path = root / AUDIT_REPORT_MD
    out_path.write_text("\n".join(lines_out) + "\n", encoding="utf-8")
    print(f"[swiftdeploy] wrote {out_path}")
    return 0


def cmd_teardown(root: Path, clean: bool) -> int:
    compose_yml = root / "docker-compose.yml"
    if compose_yml.is_file():
        try:
            data = load_manifest(root)
        except Exception:
            data = {"compose_project": "swiftdeploy"}
        compose_cmd = _compose_base(root, data)
        print("[swiftdeploy] docker compose down -v --remove-orphans")
        subprocess.run(
            compose_cmd + ["down", "-v", "--remove-orphans"],
            cwd=root,
        )
    else:
        print("[swiftdeploy] no docker-compose.yml - skipping compose down")

    if clean:
        for name in GENERATED:
            p = root / name
            if p.is_file():
                p.unlink()
                print(f"[swiftdeploy] removed {p}")

    print("[swiftdeploy] teardown finished")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="swiftdeploy")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("init", help="Render nginx.conf + docker-compose.yml from manifest.yaml")

    sub.add_parser("validate", help="Run five pre-flight checks")

    p_deploy = sub.add_parser(
        "deploy",
        help="init + OPA pre-deploy gate + compose up + wait for /healthz via nginx",
    )
    p_deploy.add_argument(
        "--timeout",
        type=float,
        default=60.0,
        help="seconds to wait for health via nginx (default: 60)",
    )

    p_promote = sub.add_parser(
        "promote",
        help="OPA pre-promote gate + set services.mode + recreate api + verify /healthz",
    )
    p_promote.add_argument("mode", choices=("canary", "stable"))

    p_status = sub.add_parser(
        "status",
        help="Live dashboard: /metrics + OPA compliance; append snapshots to history.jsonl",
    )
    p_status.add_argument(
        "--interval",
        type=float,
        default=3.0,
        help="seconds between samples (default: 3)",
    )
    p_status.add_argument(
        "-n",
        "--iterations",
        type=int,
        default=None,
        help="stop after N samples (default: run until Ctrl+C)",
    )

    sub.add_parser(
        "audit",
        help="Summarize history.jsonl into audit_report.md (timeline + violations)",
    )

    p_teardown = sub.add_parser("teardown", help="compose down -v; optional --clean removes generated files")
    p_teardown.add_argument(
        "--clean",
        action="store_true",
        help=f"delete {' + '.join(GENERATED)} from repo root",
    )

    args = parser.parse_args(argv)
    root = find_repo_root()

    if args.command == "init":
        cmd_init(root)
        return 0
    if args.command == "validate":
        return cmd_validate(root)
    if args.command == "deploy":
        return cmd_deploy(root, timeout_s=args.timeout)
    if args.command == "promote":
        return cmd_promote(root, args.mode)
    if args.command == "status":
        return cmd_status(root, interval_s=args.interval, iterations=args.iterations)
    if args.command == "audit":
        return cmd_audit(root)
    if args.command == "teardown":
        return cmd_teardown(root, args.clean)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
